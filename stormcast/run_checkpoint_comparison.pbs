#!/bin/bash
#PBS -N diffusion_ckpt_compare
#PBS -q g1
#PBS -P 17001770
#PBS -l select=1:ncpus=16:mem=110G:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /scratch/users/nus/e1155933/retraining/logs/diffusion_checkpoint_comparison.log

set -euo pipefail

export PYTHONNOUSERSITE=1

PROJECT=/data/projects/17001770/weather_department/cmd/aditya/Singapore-stormCast/stormcast
PYTHON=/scratch/users/nus/e1155933/conda/envs/sc/bin/python
CKPT_DIR=/scratch/users/nus/e1155933/retraining/runs/singv-diffusion-10years/training-100000steps-bf16-compile/checkpoints_diffusion

cd "$PROJECT"

for STEP in 20000 40000 60000 80000 100000
do
    CKPT="${CKPT_DIR}/EDMPrecond.0.${STEP}.mdlus"

    if [[ ! -f "$CKPT" ]]; then
        echo "Missing checkpoint: $CKPT" >&2
        continue
    fi

    echo
    echo "========================================"
    echo "Starting checkpoint ${STEP}: $(date)"
    echo "========================================"

    "$PYTHON" inference.py \
        --config-name singv_inference_10years \
        inference.experiment_name=singv-diffusion-checkpoint-comparison \
        inference.run_id=step-${STEP} \
        inference.diffusion_checkpoint="$CKPT" \
        sampler.args.num_steps=36

    echo "Finished checkpoint ${STEP}: $(date)"
done
